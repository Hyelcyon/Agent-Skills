{
  "preMigrationGates": {
    "maxLockTimeoutMs": 5000,
    "maxStatementTimeoutMs": 30000,
    "requireReversibleDownScript": true,
    "requireNonBlockingIndex": true,
    "forbidConcurrentIndexInsideTransaction": true,
    "forbidVolatileDefaultOnLiveTable": true,
    "requireBatchBackfillForRowsOver": 100000
  }
}
