;; Enterprise macOS Darwin Sandbox Profile (legacy local CLI isolation only; deprecated by Apple for App distribution)
;; Test via: sandbox-exec -f sandbox-profile.sb /path/to/binary

(version 1)
(deny default)

;; Permit process fork and signal
(allow process-fork)
(allow process-exec)
(allow signal (target self))

;; Permit loopback-only outbound TCP connections (replace with explicit remote target if external APIs are needed)
(allow network-outbound (remote ip "localhost:*"))

;; Allowlist read-only access to standard system libraries
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/System/Library")
    (subpath "/opt/homebrew"))

;; Allowlist application storage read/write
(allow file-read* file-write*
    (subpath "/var/log/enterprise")
    (subpath "/Library/Application Support/Enterprise"))
