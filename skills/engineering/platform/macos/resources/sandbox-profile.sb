;; Enterprise macOS Darwin Sandbox Profile
;; Test via: sandbox-exec -f sandbox-profile.sb /path/to/binary

(version 1)
(deny default)

;; Permit process fork and signal
(allow process-fork)
(allow process-exec)
(allow signal (target self))

;; Permit local network access for TCP client connections
(allow network-outbound (to-addr (literal "localhost")))
(allow network-outbound (remote ip))

;; Whitelist read-only access to standard system libraries
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/System/Library")
    (subpath "/opt/homebrew"))

;; Whitelist application storage read/write
(allow file-read* file-write*
    (subpath "/var/log/enterprise")
    (subpath "/Library/Application Support/Enterprise"))
