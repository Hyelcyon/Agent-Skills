{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindowsEnterpriseSecurityBaseline",
  "auditPolicies": {
    "accountLogon": "SuccessAndFailure",
    "privilegeUse": "SuccessAndFailure",
    "systemEvents": "SuccessAndFailure"
  },
  "registryEnforcements": [
    {
      "hive": "HKLM",
      "path": "SYSTEM\\CurrentControlSet\\Control\\Lsa",
      "name": "LimitBlankPasswordUse",
      "type": "DWord",
      "value": 1
    },
    {
      "hive": "HKLM",
      "path": "SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest",
      "name": "UseLogonCredential",
      "type": "DWord",
      "value": 0
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
      "name": "EnableLUA",
      "type": "DWord",
      "value": 1
    }
  ],
  "firewallProfiles": {
    "domain": { "enabled": true, "defaultInboundAction": "Block", "defaultOutboundAction": "Allow" },
    "private": { "enabled": true, "defaultInboundAction": "Block", "defaultOutboundAction": "Allow" },
    "public": { "enabled": true, "defaultInboundAction": "Block", "defaultOutboundAction": "Allow" }
  }
}
