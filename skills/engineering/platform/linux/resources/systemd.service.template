[Unit]
Description=Enterprise Hardened Service
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/Hyelcyon/Agent-Skills

[Service]
Type=simple
User=svc_app
Group=svc_app
WorkingDirectory=/opt/enterprise/app
ExecStart=/opt/enterprise/app/bin/server --config /opt/enterprise/app/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Process Lifecycle & Signal
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Security Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# Network & Socket Security
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource Governance (cgroups v2)
CPUQuota=200%
MemoryMin=256M
MemoryHigh=1800M
MemoryMax=2G
TasksMax=512

# File Access Whitelist
ReadWritePaths=/var/log/enterprise /var/lib/enterprise
ReadOnlyPaths=/opt/enterprise/app

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=enterprise-app

[Install]
WantedBy=multi-user.target
