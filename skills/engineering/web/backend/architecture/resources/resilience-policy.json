{
  "circuitBreaker": {
    "failureThresholdPercentage": 50,
    "slidingWindowSeconds": 30,
    "recoveryTimeoutMs": 10000,
    "minimumRequestsBeforeEvaluation": 20,
    "halfOpenMaxProbes": 1
  },
  "retryPolicy": {
    "idempotentOnly": true,
    "maxAttempts": 3,
    "backoffFactor": 2,
    "initialDelayMs": 200,
    "maxDelayMs": 2000,
    "jitter": true,
    "jitterStrategy": "full"
  },
  "perAttemptTimeoutMs": 800,
  "timeoutBudgetMs": 3000
}
