{
  "testRunner": {
    "filePatterns": [
      "tests/**/*.test.ts",
      "tests/**/*.spec.ts"
    ],
    "reporter": "spec",
    "coverage": {
      "enabled": true,
      "thresholds": {
        "lines": 85,
        "functions": 85,
        "branches": 80
      },
      "reporters": [
        "spec",
        "lcov"
      ]
    },
    "flags": [
      "--experimental-strip-types",
      "--test-concurrency=4"
    ]
  }
}
