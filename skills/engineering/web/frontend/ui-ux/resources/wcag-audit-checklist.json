{
  "wcag22AA": {
    "contrastRatio": {
      "normalText": ">= 4.5:1",
      "largeText": ">= 3:1",
      "uiComponents": ">= 3:1"
    },
    "focusManagement": {
      "visibleFocusIndicator": true,
      "keyboardTrappableDialogs": true,
      "escapeDismiss": true
    },
    "touchTargets": {
