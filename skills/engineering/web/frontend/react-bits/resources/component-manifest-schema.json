{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReactBitsComponentManifest",
  "type": "object",
  "required": ["name", "category", "variants", "dependencies"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "category": {
      "type": "string",
      "enum": ["TextAnimations", "Animations", "Backgrounds", "Components", "Micro"]
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "peerDependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["TS-TW", "TS-CSS", "JS-TW", "JS-CSS"]
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "default": {},
          "description": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
