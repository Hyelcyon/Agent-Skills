{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaudeCodeSkillFrontmatter",
  "description": "YAML frontmatter schema for Claude Code SKILL.md files combining open Agent Skills fields and Claude runtime extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024
    },
    "license": { "type": "string" },
    "compatibility": { "type": "string", "maxLength": 500 },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "argument-hint": { "type": "string" },
    "disable-model-invocation": { "type": "boolean" },
    "user-invocable": { "type": "boolean" },
    "allowed-tools": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "model": { "type": "string" },
    "effort": { "type": "string", "enum": ["low", "medium", "high", "max"] },
    "context": { "type": "string", "enum": ["fork"] },
    "agent": { "type": "string" },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hooks": { "type": "object" }
  }
}
