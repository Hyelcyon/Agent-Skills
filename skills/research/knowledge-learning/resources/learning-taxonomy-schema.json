{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningTaxonomySchema",
  "type": "object",
  "required": ["id", "title", "category", "scope", "status", "created_at", "invariant"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "environment",
        "architecture",
        "user_preference",
        "workaround",
        "tooling",
        "test_harness"
      ]
    },
    "scope": {
      "type": "string",
      "description": "File glob or path where this invariant applies"
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Deprecated", "Superseded"]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "invariant": {
      "type": "string",
      "description": "Clear statement of the mandatory rule or procedure"
    },
    "verification_command": {
      "type": "string",
      "description": "Command to verify the invariant holds"
    }
  },
  "additionalProperties": false
}
